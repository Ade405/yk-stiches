# YK Stitches Environment Configuration
# Copy this file to .env.local and fill in your values

# Gemini AI Configuration
# Required for AI-assisted tailor consultation features
GEMINI_API_KEY="your-gemini-api-key-here"

# Application URL (used for password reset links, OAuth callbacks, etc.)
# In development: http://localhost:3000
# In production: https://your-domain.com
APP_URL="http://localhost:3000"

# Supabase Configuration
# Create a project at https://supabase.com
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Authentication Credentials
# IMPORTANT: Change these in production!
# Use strong, random passwords
ADMIN_PASSWORD="admin123"
DEMO_USER_PASSWORD="demo1234"
TAILOR_PASSWORD="tailor123"

# Node Environment
# development: Full logging, no HTTPS requirement
# production: Minimal logging, HTTPS required, strict validation
NODE_ENV="development"

# HTTPS Configuration (optional, for production)
# Required when NODE_ENV=production
# Uncomment and set paths to enable HTTPS
# TLS_KEY_PATH=/path/to/private-key.pem
# TLS_CERT_PATH=/path/to/certificate.pem

# Email Configuration (optional, for password reset emails)
# When configured, users will receive password reset links via email
# Otherwise, links are logged to console in development
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="noreply@yk-stitches.com"

# Error Tracking (optional)
# Setup error tracking with Sentry or similar
# SENTRY_DSN="https://your-key@sentry.io/your-project-id"

# Analytics (optional)
# ANALYTICS_KEY="your-analytics-key"

# Supabase Storage Configuration (for image uploads)
# Bucket names and settings
# SUPABASE_STORAGE_BUCKET="product-images"

